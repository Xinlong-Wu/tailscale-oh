# OpenHarmony Go toolchain used by the OpenHarmony build and test lane.
#
# The archives are published by Xinlong-Wu/go-ohos. Keep this file pinned to a
# release that has been reviewed for this repository. In particular, do not
# silently move this to a newer upstream Go release: the wrapper deliberately
# stops when go.mod or go.toolchain.rev changes.

GO_OHOS_REPOSITORY="Xinlong-Wu/go-ohos"
GO_OHOS_RELEASE="go1.26.8-ohos.1"
GO_OHOS_GO_VERSION="1.26.8"

# These are the values reviewed when v1.102.3 was synchronized. A later
# upstream sync that changes either value must be reviewed before this lane can
# be updated.
GO_OHOS_REVIEWED_GO_MOD_VERSION="1.26.6"
GO_OHOS_REVIEWED_TOOLCHAIN_REV="7275f792d406d3c386cc807937a45a4a7b699d42"

# SHA-256 of the release assets above. The archive name is
# ${GO_OHOS_RELEASE}-${host_arch}.tar.gz.
GO_OHOS_SHA256_AMD64="f47de68f3b6a86a87cd8210888bd446d85732c730ecfb2c0391ca0517be88ddf"
GO_OHOS_SHA256_ARM64="798a82d7aecf601a0a949386c33e90f620dfc0beddea4ea06c161d8d714ab624"

# DockerHarmony is a small OpenHarmony rootfs. Pin the digest so a mutable
# image tag cannot change the runtime used by CI or local regression tests.
OPENHARMONY_DOCKER_IMAGE="ghcr.io/hqzing/dockerharmony:6.1@sha256:191308181ea8de34528bfc8eaad5ec67fef76f7a30d57eb4ad980bfc6177f115"
